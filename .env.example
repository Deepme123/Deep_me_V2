# Primary LLM provider.
# Allowed: openai, anthropic
# Emergency rollback target: openai
LLM_PROVIDER=openai

# Shared LLM defaults for backend/analyze/desire.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SEC=60

# Reasoning models (gpt-5*/gpt-6*/o3*/o4*) never receive temperature.
# Extra prefixes can be added comma-separated. Effort applies to reasoning models only.
# Demo 1.2: LLM_MODEL=gpt-6-luna, JUDGE_MODEL=gpt-6-luna, LLM_REASONING_EFFORT=low
# LLM_REASONING_MODEL_PREFIXES=
# LLM_REASONING_EFFORT=low

# Judge (progress memo) model; if unset, it uses LLM_MODEL.
# JUDGE_MODEL=
# JUDGE_ENABLED=true
# Demo 1.2 flow tuning and per-turn flow/memo logging.
# FLOW_OFFER_MIN_USER_COUNT=4
# FLOW_DEEP_MAX_TURNS=9
# FLOW_MEMO_LOG=false

# Optional OpenAI chat fallback models used by the backend stream path.
LLM_BACKUP_MODELS=gpt-4o-mini,gpt-4o

# OpenAI credentials and optional routing.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
# OPENAI_PROJECT=

# Anthropic credentials.
# Keep this empty until Claude is explicitly enabled.
# For safe rollback, keep OPENAI_API_KEY configured even while Anthropic is enabled.
ANTHROPIC_API_KEY=

# APP_ENV=development enables local-only conveniences like EMOTION_NO_AUTH_WEB_TEST.
# Never set this to development/local in a deployed environment.
APP_ENV=development
# EMOTION_NO_AUTH_WEB_TEST=false

# Desire service can override only its model if needed.
# If unset, it uses LLM_MODEL.
# NEED_CARD_MODEL=gpt-4.1-mini

# Deploy webhook (app/backend/routers/deploy_webhook.py).
# main push -> PROD Render service, develop push -> TEST Render service.
GITHUB_WEBHOOK_SECRET=

RENDER_DEPLOY_HOOK_URL_PROD=
RENDER_API_KEY_PROD=
RENDER_SERVICE_ID_PROD=
DISCORD_WEBHOOK_URL_PROD=

RENDER_DEPLOY_HOOK_URL_TEST=
RENDER_API_KEY_TEST=
RENDER_SERVICE_ID_TEST=
DISCORD_WEBHOOK_URL_TEST=

# 회원탈퇴 예약/삭제 완료 Discord 알림(app/backend/services/deletion_notify.py).
# 배포 알림(DISCORD_WEBHOOK_URL_*), 에러 로그(DISCORD_ERROR_WEBHOOK_URL)와는 별개 채널.
# 비워두면 알림을 보내지 않는다.
DISCORD_DELETION_WEBHOOK_URL=

# 관리자 전용 라우터(app/backend/routers/deletion_feedback.py) 접근 시크릿.
# X-Admin-Secret 헤더로 검증하며, 비워두면 해당 라우터 전체가 막힌다(fail-closed).
ADMIN_API_SECRET=
