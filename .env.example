# Primary LLM provider.
# Allowed: openai, anthropic
# Emergency rollback target: openai
LLM_PROVIDER=openai

# Shared LLM defaults for backend/analyze/desire.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SEC=60

# Optional OpenAI chat fallback models used by the backend stream path.
LLM_BACKUP_MODELS=gpt-4o-mini,gpt-4o

# OpenAI credentials and optional routing.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
# OPENAI_PROJECT=

# Anthropic credentials.
# Keep this empty until Claude is explicitly enabled.
# For safe rollback, keep OPENAI_API_KEY configured even while Anthropic is enabled.
ANTHROPIC_API_KEY=

# APP_ENV=development enables local-only conveniences like EMOTION_NO_AUTH_WEB_TEST.
# Never set this to development/local in a deployed environment.
APP_ENV=development
# EMOTION_NO_AUTH_WEB_TEST=false

# Desire service can override only its model if needed.
# If unset, it uses LLM_MODEL.
# NEED_CARD_MODEL=gpt-4.1-mini

# Deploy webhook (app/backend/routers/deploy_webhook.py).
# main push -> PROD Render service, develop push -> TEST Render service.
GITHUB_WEBHOOK_SECRET=

RENDER_DEPLOY_HOOK_URL_PROD=
RENDER_API_KEY_PROD=
RENDER_SERVICE_ID_PROD=
DISCORD_WEBHOOK_URL_PROD=

RENDER_DEPLOY_HOOK_URL_TEST=
RENDER_API_KEY_TEST=
RENDER_SERVICE_ID_TEST=
DISCORD_WEBHOOK_URL_TEST=
